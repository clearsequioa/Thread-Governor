	"license": "MIT",
	"icon": "assets/threadgovernor/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.lowcore.threadgovernor.ThreadGovernorClient"],
		"modmenu": ["dev.lowcore.threadgovernor.ModMenuIntegration"]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"sodium": "*",
		"modmenu": "*",
		"cloth-config": "*"
	}
}
